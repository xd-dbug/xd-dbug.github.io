---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Page not found" description="That page doesn't exist.">
  <div class="font-mono">
    <p class="text-sm text-muted">
      <span class="text-accent">$</span> cd <span id="missing-path">that-page</span>
    </p>
    <script is:inline>
      document.getElementById('missing-path').textContent = location.pathname;
    </script>
    <h1 class="mt-3 text-2xl font-bold text-strong sm:text-3xl">404: no such file or directory</h1>
    <p class="mt-4 font-sans text-muted">
      That page doesn't exist, or it moved. Try the home page, or one of the links above.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg hover:opacity-90"
    >
      cd ~ <span aria-hidden="true">→</span>
    </a>
  </div>
</PageLayout>

---
import PageLayout from '../../layouts/PageLayout.astro';
import PromptTitle from '../../components/PromptTitle.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<PageLayout title="Projects" description="Software projects by Damian Swiney, each with the problem it solves, how it works, and how to run it.">
  <PromptTitle
    command="ls -l ~/projects"
    title="Projects"
    lead="Each write-up covers the problem, a demo, how it works, how to run it, and what I learned."
  />
  {
    projects.length > 0 ? (
      <ul class="group/list space-y-12">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} headingLevel={2} />
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState message="no projects published yet" />
    )
  }
</PageLayout>

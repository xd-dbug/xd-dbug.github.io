---
import PageLayout from '../../layouts/PageLayout.astro';
import PromptTitle from '../../components/PromptTitle.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear());
const shortDate = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' });
---

<PageLayout title="Blog" description="Notes on building software, by Damian Swiney.">
  <PromptTitle command="ls -lt ~/blog" title="Blog">
    <p class="mt-4 font-mono text-sm">
      <a href="/rss.xml" class="text-link hover:underline">rss.xml</a>{' '}
      <span class="text-muted"># subscribe in any feed reader</span>
    </p>
  </PromptTitle>
  {
    posts.length > 0 ? (
      <div class="space-y-10">
        {[...byYear].map(([year, items]) => (
          <section aria-labelledby={`y${year}`}>
            <h2 id={`y${year}`} class="font-mono text-sm font-bold text-muted">
              {year}
            </h2>
            <ul class="mt-3 divide-y divide-line border-y border-line">
              {items.map(({ id, data }) => (
                <li>
                  <a href={`/blog/${id}/`} class="group grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[5rem_1fr]">
                    <time datetime={data.date.toISOString()} class="font-mono text-sm text-muted">
                      {shortDate(data.date)}
                    </time>
                    <span>
                      <span class="font-medium text-strong group-hover:text-accent">{data.title}</span>
                      <span class="mt-1 block text-sm text-muted">{data.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <EmptyState message="no posts yet" />
    )
  }
</PageLayout>

---
// Inner pages (projects, resume, blog, contact, 404): prompt-style header + nav, footer.
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ElsewhereLinks from '../components/ElsewhereLinks.astro';
import { site, nav, lastUpdated, formatDate } from '../data/site';
import { getTestimonials, MIN_TESTIMONIALS } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Wider main column (e.g. the projects list). */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname;

// The testimonials link appears only once the page exists (≥ MIN_TESTIMONIALS entries).
const showTestimonials = (await getTestimonials()).length >= MIN_TESTIMONIALS;
const navItems = showTestimonials
  ? [...nav.slice(0, -1), { label: 'testimonials', href: '/testimonials/' }, ...nav.slice(-1)]
  : nav;
---

<BaseLayout title={title} description={description}>
  <div class:list={['mx-auto flex min-h-screen flex-col px-4 sm:px-6 print:max-w-none print:px-0', wide ? 'max-w-5xl' : 'max-w-3xl']}>
    <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6 font-mono text-sm print:hidden">
      <a href="/" class="font-medium" aria-label={`${site.name}, home`}>
        <span class="text-accent">damian@portfolio</span><span class="text-muted">:~$</span>
      </a>
      <div class="flex items-center gap-4">
        <nav aria-label="Main">
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {
              navItems.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    aria-current={path.startsWith(href) ? 'page' : undefined}
                    class="text-muted hover:text-accent aria-[current=page]:text-accent"
                  >
                    ./{label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="content" class="flex-1 py-10 print:py-0">
      <slot />
    </main>

    <footer class="flex flex-wrap items-baseline justify-between gap-4 border-t border-line py-8 font-mono text-xs text-muted print:hidden">
      <ElsewhereLinks />
      <p><span class="text-accent">#</span> last updated {formatDate(lastUpdated)}</p>
    </footer>
  </div>
</BaseLayout>

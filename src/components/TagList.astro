---
interface Props {
  tags: string[];
  label?: string;
  class?: string;
}
const { tags, label = 'Technologies used', class: className = 'mt-3' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-2', className]} aria-label={label}>
      {tags.map((t) => (
        <li class="rounded-full bg-accent/10 px-3 py-1 font-mono text-xs text-accent-ink">{t}</li>
      ))}
    </ul>
  )
}

---
// "# label" heading. Sticky with a blurred backdrop on small screens; visually hidden on lg,
// where the home page's side nav labels the sections instead.
interface Props {
  label: string;
  /** Hide visually on lg (home page split layout). */
  srOnlyOnLg?: boolean;
}
const { label, srOnlyOnLg = false } = Astro.props;
---

<div
  class:list={[
    'sticky top-0 z-20 -mx-4 mb-4 bg-bg/80 px-4 py-5 backdrop-blur sm:-mx-6 sm:px-6',
    srOnlyOnLg && 'lg:sr-only',
  ]}
>
  <h2 class="font-mono text-sm font-bold tracking-widest text-strong uppercase">
    <span class="text-accent">#</span>{' '}{label}
  </h2>
</div>

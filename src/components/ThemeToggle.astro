---
// Light/dark switch. BaseLayout's inline script picks the initial theme; this flips and saves it.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Dark theme"
  aria-pressed="false"
  class:list={[
    'inline-flex size-9 items-center justify-center rounded-md border border-line text-muted transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none',
    className,
  ]}
>
  <!-- Moon (shown in light theme) -->
  <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <!-- Sun (shown in dark theme) -->
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () =>
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(root.dataset.theme === 'dark')));

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked: the choice lasts for this page view only.
      }
    }),
  );
  // Keep aria-pressed right for clicks and for system-theme changes alike.
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  sync();
</script>

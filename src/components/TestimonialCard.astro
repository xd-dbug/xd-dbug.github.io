---
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}
const t = Astro.props.testimonial.data;
---

<figure class="rounded-md border border-line bg-surface p-6">
  <blockquote class="text-fg before:mr-1 before:font-mono before:text-accent before:content-['>']">
    {t.quote}
  </blockquote>
  <figcaption class="mt-4 text-sm">
    <span class="font-medium text-strong">
      {t.url ? <a href={t.url} class="hover:text-accent">{t.name}</a> : t.name}
    </span>
    <span class="text-muted">· {t.title}</span>
    <span class="mt-1 block font-mono text-xs text-muted"><span class="text-accent">#</span> {t.relationship}</span>
  </figcaption>
</figure>

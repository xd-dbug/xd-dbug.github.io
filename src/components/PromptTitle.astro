---
// Page heading block for inner pages: "$ command" line, h1, optional lead paragraph.
interface Props {
  command: string;
  title: string;
  lead?: string;
}
const { command, title, lead } = Astro.props;
---

<header class="mb-10">
  <p class="font-mono text-sm text-muted"><span class="text-accent" aria-hidden="true">$</span> {command}</p>
  <h1 class="mt-2 font-mono text-3xl font-bold tracking-tight text-strong sm:text-4xl">{title}</h1>
  {lead && <p class="mt-4 max-w-2xl text-lg text-muted">{lead}</p>}
  <slot />
</header>

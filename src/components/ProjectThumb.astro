---
// Project cover thumbnail, or a terminal-window placeholder when there's no cover image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  cover?: ImageMetadata;
  class?: string;
}
const { slug, cover, class: className } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded border-2 border-line bg-surface transition-colors group-hover:border-accent/40 motion-reduce:transition-none',
    className,
  ]}
  aria-hidden="true"
>
  {
    cover ? (
      <Image src={cover} alt="" width={320} class="aspect-[16/10] w-full object-cover" />
    ) : (
      <>
        <div class="flex gap-1 border-b border-line px-2 py-1.5">
          <span class="size-1.5 rounded-full bg-[#ff5f57]" />
          <span class="size-1.5 rounded-full bg-[#febc2e]" />
          <span class="size-1.5 rounded-full bg-[#28c840]" />
        </div>
        <p class="truncate px-2 py-3 font-mono text-[10px] text-muted">
          <span class="text-accent">~</span>/{slug}
        </p>
      </>
    )
  }
</div>

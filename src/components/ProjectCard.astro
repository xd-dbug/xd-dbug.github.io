---
// Project entry for lists (home, /projects). Parent list needs class "group/list".
import type { CollectionEntry } from 'astro:content';
import HoverCard from './HoverCard.astro';
import ProjectThumb from './ProjectThumb.astro';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 2 | 3;
}
const { project, headingLevel } = Astro.props;
const { id, data: p } = project;
---

<HoverCard href={`/projects/${id}/`} title={p.title} {headingLevel} asideLastOnMobile>
  <ProjectThumb slot="aside" slug={id} cover={p.cover} class="w-40 sm:mt-1 sm:w-auto" />
  <p class="mt-2 text-sm text-muted">{p.summary}</p>
  <TagList tags={p.stack} />
</HoverCard>
